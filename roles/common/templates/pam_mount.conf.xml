<volume
    fstype="fuse"
    mountpoint="/home/{{ user }}/Pictures"
    path="/usr/bin/gocryptfs#{{ external_pics }}"
    options="nodev,nosuid"
    user="{{ user }}"
/>
<volume
    fstype="fuse"
    mountpoint="/home/{{ user }}/Documents"
    path="/usr/bin/gocryptfs#{{ external_docs }}"
    options="nodev,nosuid"
    user="{{ user }}"
/>
